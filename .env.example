# Prefer NEXT_PUBLIC_* on Node Render; VITE_* aliases still work via runtimeEnv / next.config.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Legacy aliases (optional if NEXT_PUBLIC_* set):
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# or: VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PAYMENT_LINK is NOT used — own Checkout Session via Edge Function
# STRIPE_SECRET_KEY belongs in Supabase Edge Function secrets (never NEXT_PUBLIC_* / VITE_*)

VITE_ADMIN_CODE=change-this-admin-code
VITE_PLATFORM_OWNER_ID=your-supabase-user-uuid

# Live / OBS (optional). OBS Studio is free — window share works without these.
# Self-host: docs/mediamtx.md + docker/mediamtx/
# VITE_LIVE_RTMP_URL=rtmp://YOUR_HOST:1935/live
# VITE_LIVE_HLS_BASE=https://YOUR_HOST/live
# VITE_LIVE_INGEST_CONNECTED=true

# Social OAuth publish (optional — handles work without these; publish stays off):
# VITE_OAUTH_YOUTUBE_CLIENT_ID=
# VITE_OAUTH_TIKTOK_CLIENT_ID=
# VITE_OAUTH_INSTAGRAM_CLIENT_ID=
# VITE_OAUTH_X_CLIENT_ID=
# VITE_OAUTH_FACEBOOK_CLIENT_ID=
# VITE_OAUTH_START_URL=https://YOUR_PROJECT.supabase.co/functions/v1/oauth-start
# Edge secrets: OAUTH_REDIRECT_BASE, APP_PUBLIC_URL, *_CLIENT_SECRET

# Mail Edge Function (without this, verify flows show a demo code):
# VITE_MAIL_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/send-mail

# Web Push (free VAPID — npx web-push generate-vapid-keys):
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VITE_PUSH_SUBSCRIBE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/push-subscribe

# Optional browser ffmpeg.wasm compress (off by default — keep original for iOS):
# VITE_CLIENT_TRANSCODE=1

# Deploy Edge Functions:
#   supabase functions deploy create-checkout-session
#   supabase functions deploy create-connect-account
#   supabase functions deploy oauth-start
#   supabase functions deploy oauth-callback
#   supabase functions deploy push-subscribe
# Infra: docs/INFRA.md | Env checklist: docs/RENDER_ENV.md | Live self-host: docs/mediamtx.md
# Sign-in: Authentication → Providers → Email (Apple needs paid Apple Developer).
# Server only (Edge Function secret, not Render client env):
# STRIPE_SECRET_KEY=sk_test_...
